{
  "uid": "gaz-marginal",
  "title": "Marginal Cost",
  "tags": [
    "gaz"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Marginal cost per MWh by plant",
      "description": "(gas + carbon x emissions_factor) / efficiency, in EUR per MWh ELECTRICAL. A unit cost, not the cost of running the plant \u2014 capacity is not a factor. Both terms divide by efficiency: making 1 MWh electrical burns 1/eff MWh thermal, and that burn is what emits. Gas is EUR/MWh thermal, LHV basis.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "gaz-rdb"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "gaz-rdb"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://rdb:6002/gaz/marginal",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "sym",
              "text": "sym",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "value",
              "type": "number"
            }
          ],
          "filters": [],
          "parser": "backend"
        }
      ],
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "sym"
            ],
            "keepFields": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "min",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Input marks (TTF gas EUR/MWh thermal, EUA carbon EUR/tCO2)",
      "description": "The same two marks feed every plant; what separates the plants above is only their efficiency.",
