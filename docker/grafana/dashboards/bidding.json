  "panels": [
    {
      "type": "stat",
      "title": "Gas position \u2014 TEST_UNIVERSAL_TTF",
      "description": "MWh THERMAL, one shared portfolio for the whole fleet. There is no gas at a power station \u2014 a CCGT takes gas off the grid against a shipper portfolio, so there is one position here and not one per plant. physical = delivered minus burnt. reserved = earmarked against open offers; submitting reserves, only dispatch burns. available = physical minus reserved, and is what may still be offered by ANY unit \u2014 they compete for the same gas. forward = bought but not yet delivered, on the book and not in the pool. wacog = weighted average cost of what remains, EUR/MWh thermal: book against it, but BID on the market mark, because gas already bought can be resold.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "gaz-rdb"
      },
      "gridPos": {
        "h": 9,
        "w": 9,
        "x": 0,
        "y": 0
