# Local data — the cloud equivalents live on FSx / EBS, never in git
data/

# Linux kdb+ builds used by the docker image. Licensed KX binaries —
# staged locally, never committed. See docker/Dockerfile.
kdb/

# Machine-specific environment overrides (QHOME, ports, mount points)
env.local.sh

# k4unit artefacts
KUTR.csv
tests/results/

# Python bytecode from the tick handlers
__pycache__/

# q / editor
*.log
.DS_Store
scratch**

# Terraform working files. State can hold resource detail you don't want
# public, and .terraform/ is downloaded provider binaries.
#
# .terraform.lock.hcl is deliberately NOT ignored: committing it pins the
# provider versions so a later release cannot change what apply does.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*hcl
